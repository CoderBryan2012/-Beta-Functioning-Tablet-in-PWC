varol mod = {}

mod.clrs = {
    ["gry"] = colorHex("#808080"),
    ["grn"] = colorHex("#50C878"),
    ["blck"] = colorHex("#000000"),
    ["blu"] = colorHex("#87CEEB"),
    ["white"] = colorHex("#ffffff"),
    ["yllw"] = colorHex("#DFFF00"),
    ["tn"] = colorHex("#C9CC3F"),
}

mod.sts = {
    ["on"] = false,
    ["debounce"] = false,
    ["menu"] = false,
    ["dronba"] = false
}

func changeUI(n, c, t, x, y)
    n.BackgroundTransparency = c
    if t == "t" then
        n.TextTransparency = c
    end
    n.Position = udim2(x, 0, y, 0)
    n.LayoutOrder = 1
end

func afkplotfarm(afk)
	func collect()
    	if drone.canHarvest() OR drone.getPlantHasFruit() then
			drone.harvest()
        	if player.getInventorySize() >= player.getFruitCapacity() then
    			market.sellAllItem()
			end
               
		elseif drone.canCrop() then
        	drone.crop()
            if player.getInventorySize() >= player.getFruitCapacity() then
				market.sellAllItem()
			end
        end
	end
	print("hello")
    varol pos = garden.getGardenPositions()

    for crd inpairs(pos) do
		varol crdl = string.len(crd)
		varol fndcmma = string.find(crd,",")

		varol x = string.sub(crd, 0, fndcmma-1)
		varol y = string.sub(crd, fndcmma+1, crdl)

        droneV2.goto(tonumber(x),tonumber(y))
        collect()
	end
	if afk then
		market.sellAllItem()
		afkplotfarm(true)
	end
end

mod.changeUI = changeUI
mod.afkplotfarm = afkplotfarm
return mod   
